from pygame import *
from random import *
from time import time as timer


color_w = (0, 0, 100)
window = display.set_mode((600, 500))
window.fill(color_w)
game = True
Finish = False
FPS = 30
clock = time.Clock()
speed_y = 3
speed_x = 3


class GameSprite(sprite.Sprite):
    def __init__(self, player_image, player_speed, player_x, player_y, size_x, size_y):
        super().__init__()
        self.image = transform.scale(image.load(player_image), (size_x, size_y))
        self.speed = player_speed
        self.rect = self.image.get_rect()
        self.rect.x = player_x
        self.rect.y = player_y
    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def update_R(self):
        keys = key.get_pressed()
        if keys[K_UP] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[K_DOWN] and self.rect.y < 495:
            self.rect.y += self.speed

    def update_L(self):
        keys = key.get_pressed()
        if keys[K_w] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[K_s] and self.rect.y < 495:
            self.rect.y += self.speed

class Enemy(GameSprite):
    def update(self):
        self.rect.y += self.speed
        global lost 
        if self.rect.y > 500:
            self.rect.x = randint(25, 675)
            self.rect.y = 0
            lost += 1

font.init()
font = font.Font(None, 35)
lose_R = font.render('WIN Left', True, (255, 255, 255))
lose_L = font.render('WIN Right', True, (255, 255, 255))


tennis_ball = GameSprite('tennis_ball.png', 10, 300, 250, 40, 40)
tennis_racketL = Player('tennis_racket.png', 10, 25, 210, 100, 150)
tennis_racketR = Player('tennis_racket.png', 10, 475, 210, 100, 150)

while game:
    for i in event.get():
        if i.type == QUIT:
            game = False
    if Finish != True:
        window.fill(color_w)
        tennis_racketL.update_L()
        tennis_racketR.update_R()
        tennis_ball.rect.x += speed_x 
        tennis_ball.rect.y += speed_y
        if tennis_ball.rect.x > 475:
            window.blit(lose_L, (270, 250))
            Finish == True
        if tennis_ball.rect.x < 25:
            window.blit(lose_R, (270, 250))
            Finish == True
        if tennis_ball.rect.y > 500 or tennis_ball.rect.y < 0:
            speed_y *= -1 
        if sprite.collide_rect(tennis_racketL, tennis_ball)  or sprite.collide_rect(tennis_racketR, tennis_ball):
            speed_x *= -1
            speed_y *= 1
            
    tennis_racketL.reset()
    tennis_racketR.reset()
    tennis_ball.reset()
        
    
    
    clock.tick(FPS)
    display.update()
